{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "saitei-chingin",
  "main": "src/worker.tsx",
  "compatibility_date": "2026-07-29",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "saitei-chingin.yhay81.com", "custom_domain": true }],
  "triggers": { "crons": ["31 22 * * *"] },
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "saitei-chingin",
      "database_id": "da4a21b6-b3db-4b48-a1f1-5ee637a01ca6",
      "migrations_dir": "migrations",
    },
  ],
  "assets": { "directory": "./public", "binding": "ASSETS" },
}
